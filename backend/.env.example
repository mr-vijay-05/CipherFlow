# CipherFlow Phase 3 - Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="CipherFlow Cloud Sync API"

# Database Configuration (PostgreSQL default, with automatic SQLite fallback if PostgreSQL is unconfigured)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cipherflow
# Fallback SQLite DB for development if Postgres credentials are not configured:
SQLITE_FALLBACK_URL=sqlite:///./cipherflow_dev.db

# Security & CORS
SECRET_KEY=development_only_secret_key_change_in_production_32bytes!
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Constraints
MAX_PAYLOAD_BYTES=10485760 # 10 MB limit
