# CipherFlow Phase 3 - Environment Configuration
ENVIRONMENT=development
API_V1_STR=/api/v1
PROJECT_NAME="CipherFlow Cloud Sync API"

# Database Configuration: SQLite default for local zero-config, or set your PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/cipherflow
DATABASE_URL=sqlite:///./cipherflow_dev.db

# Security & CORS
SECRET_KEY=development_only_secret_key_change_in_production_32bytes!
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Constraints
MAX_PAYLOAD_BYTES=10485760
